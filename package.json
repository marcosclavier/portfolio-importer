{
  "name": "portfolio-importer",
  "version": "0.1.0",
  "description": "Reads a code repository the way Portfolio Studio does: picks a small set of files, never opens secret-prone ones, removes secrets from the rest, and writes a receipt of everything it read.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/marcosclavier/portfolio-importer.git" },
  "engines": { "node": ">=20" },
  "bin": { "portfolio-importer": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
